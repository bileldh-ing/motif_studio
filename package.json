{
  "name": "motif-studio",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b packages/project-schema packages/editor-core packages/render-engine packages/cloud-client",
    "dev:desktop": "pnpm --filter @motif/desktop dev",
    "build:desktop": "pnpm --filter @motif/desktop build",
    "demo:render": "node --experimental-strip-types scripts/demo-render.ts",
    "dev:api": "pnpm --filter @motif/api dev",
    "dev:web": "pnpm --filter @motif/web dev",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/darwin-x64",
      "@embedded-postgres/linux-arm64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/windows-x64",
      "electron",
      "esbuild"
    ]
  }
}