    "drizzle-orm": "^0.44.0",
    "fastify": "^5.4.0",
    "pg": "^8.16.0",
    "stripe": "^18.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
